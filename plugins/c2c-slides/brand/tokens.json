  "rules": [
    "Gold nigdy jako tekst body 16px; tylko akcenty, etykiety >=14px bold, ikony, linie, stopy gradientu.",
    "CTA Blue tylko jako drobny akcent funkcjonalny (np. czwarta seria wykresu); nigdy linki w tekście, nigdy przyciski w prezentacji.",
    "Warm Cream nigdy jako pełne tło; tylko stop gradientu, tekst na ciemnym, delikatne wypełnienia.",
    "Navy Deep nigdy samodzielnie, tylko w gradiencie z Deep Navy.",
    "Body zawsze Deep Navy na jasnym lub Warm White na ciemnym. Brak dodatkowych szarości.",
    "Bez pure white jako dominującego tła, bez neonów, glassmorphism, 3D, wielokolorowych gradientów."
  ],
  "gradients": {
    "atmosphericDark": {
      "angle": 165,
      "stops": [
        "#1D2E60",
        "#222A3F"
      ]
    },
    "atmosphericLight": {
      "angle": 180,
      "stops": [
        "#FFF8F2",
        "#ECD3BE"
      ]
    },
    "separator": {
      "angle": 165,
      "stops": [
        "#A37A5C",
        "#ECD3BE"
      ]
    }
  },
