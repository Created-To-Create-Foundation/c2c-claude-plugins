{
  "$comment": "Źródło: kod produkcyjny createdtocreate.pl (app/globals.css) > docs > brandbook. Wartości zweryfikowane 2026-09-19.",
  "colors": {
    "navy": "#222A3F",
    "navyDeep": "#1D2E60",
    "gold": "#A37A5C",
    "blue": "#447CD9",
    "warmWhite": "#FFF8F2",
    "cream": "#ECD3BE",
    "brownMid": "#8B6248",
    "brownDark": "#6B4936",
    "scrim": "#0D1428",
